+# T-Mobile-style upstreams rotate the delegated /64 constantly; the source
+# pinned once by firstconnect() goes stale the moment its prefix's route is
+# removed, falsely downing a healthy link until the next mwan3 restart.
+# For ipv6 members re-derive the ping source once per round: prefer a
+# non-deprecated global address, then fall back to deprecated ones (they
+# still route fine), and only use an address that currently has a working
+# source-constrained route to a track target.
+# v2.1: route presence is NOT enough -- the carrier stops forwarding from
+# old /64s while the kernel "default from" route still exists, wedging the
+# tracker on a dead prefix. So ping-test candidates too: try the source
+# that answered last round first (fast path), then preferred/deprecated in
+# order, and pick the first that BOTH routes and answers. If nothing
+# answers this round (true carrier outage) fall back to a route-valid
+# source so normal failure accounting keeps running.
+refresh_src_ip() {
+	local cand probe_ip cands
+	[ "$FAMILY" = "ipv6" ] || return 0
+	[ -n "$DEVICE" ] || return 0
+	for probe_ip in $track_ips; do break; done
+	[ -n "$probe_ip" ] || return 0
+	# Log when no candidates exist — makes silent failures visible.
+	cands=$(ip -6 addr show dev "$DEVICE" scope global 2>/dev/null | awk '/inet6/{print $2}')
+	[ -z "$cands" ] && LOG warn "$INTERFACE ($DEVICE): no ipv6 globals on device; cannot re-derive"
+	for cand in \
+		$(ip -6 addr show dev "$DEVICE" scope global 2>/dev/null | \
+			awk -v cur="$SRC_IP" '/inet6/ {a=$2; sub(/\/.*/, "", a); if (a == cur && !seen) {f=f " " a; seen=1} else if ($0 ~ /deprecated/) d=d " " a; else p=p " " a}
+			     END {print f p d}'); do
+		if ip -6 route get "$probe_ip" from "$cand" oif "$DEVICE" >/dev/null 2>&1 && \
+		   $PING -n -c 1 -W 2 -q -I "$cand" "$probe_ip" >/dev/null 2>&1; then
+			if [ "$cand" != "$SRC_IP" ]; then
+				SRC_IP=$cand
+				LOG info "Re-derived ipv6 source for $INTERFACE ($DEVICE): now $SRC_IP"
+			fi
+			return 0
+		fi
+	done
+	for cand in \
+		$(ip -6 addr show dev "$DEVICE" scope global 2>/dev/null | \
+			awk -v cur="$SRC_IP" '/inet6/ {a=$2; sub(/\/.*/, "", a); if (a == cur && !seen) {f=f " " a; seen=1} else if ($0 ~ /deprecated/) d=d " " a; else p=p " " a}
+			     END {print f p d}'); do
+		if ip -6 route get "$probe_ip" from "$cand" oif "$DEVICE" >/dev/null 2>&1; then
+			if [ "$cand" != "$SRC_IP" ]; then
+				SRC_IP=$cand
+				LOG info "No ipv6 source answered; fell back to route-valid $SRC_IP on $INTERFACE ($DEVICE)"
+			fi
+			return 0
+		fi
+	done
+	return 0
+}
