+# v6 probe: the LD_PRELOAD sockopt wrapper (SO_MARK=MMX_DEFAULT +
+# SO_BINDTODEVICE + source bind) cannot reach global targets from a
+# deprecated source on this carrier's rotating /64 setup: pings that the
+# kernel accepts never get replies, so the link looks down even though
+# unmarked pings work fine and the link carries traffic. Tracked v6
+# members therefore probe with a plain, unmarked busybox ping bound to the
+# refresh-chosen source (-I). That routes via the source's "default from"
+# route in the main table (never leaks to another WAN), and -- unlike the
+# wrapper socket -- works from deprecated sources. IPv4 keeps WRAP.
+track_ping() {
+	# shellcheck disable=SC2086
+	if [ "$FAMILY" = "ipv6" ]; then
+		if [ -n "$SRC_IP" ]; then
+			$PING -n -c $count -W $timeout -s $size -t $max_ttl -q -I "$SRC_IP" $track_ip
+		else
+			$PING -n -c $count -W $timeout -s $size -t $max_ttl -q $track_ip
+		fi
+	else
+		WRAP $PING -n -c $count -W $timeout -s $size -t $max_ttl -q $track_ip
+	fi
+}
