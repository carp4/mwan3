--- a/files/usr/sbin/mwan3track
+++ b/files/usr/sbin/mwan3track
@@ -20,6 +20,32 @@ WRAP() {
 	FAMILY=$FAMILY DEVICE=$DEVICE SRCIP=$SRC_IP FWMARK=$MMX_DEFAULT LD_PRELOAD=/lib/mwan3/libwrap_mwan3_sockopt.so.1.0 $*
 }
 
+# Same as WRAP but with an explicit source address, for candidate testing.
+WRAP_SRC() {
+	# shellcheck disable=SC2048
+	local _src=$1
+	shift
+	FAMILY=$FAMILY DEVICE=$DEVICE SRCIP=$_src FWMARK=$MMX_DEFAULT LD_PRELOAD=/lib/mwan3/libwrap_mwan3_sockopt.so.1.0 $*
+}
+
+# Both families probe through the wrapper. Binding only the source is NOT
+# enough on this build: mwan3_hook sits on OUTPUT and mwan3_rules sends every
+# unmarked packet to mwan3_policy_failover, which stamps the failover mark
+# (table 17 -> the failover uplink). The echo request still leaves the member's
+# own device (the bound source's "default from" route wins on transmit), but the
+# flow is masqueraded with the failover uplink's address, so the reply comes
+# back over the failover uplink instead of the member's. Measured on a
+# two-modem box with per-device ICMPv6 counters: 20 unmarked pings from a
+# modem's address gave 20 echo requests on that modem and 20 replies on the
+# failover uplink, so the member's return path was never tested and the probe
+# went down with the failover uplink. FWMARK=MMX_DEFAULT makes the policy hook
+# skip the probe, so masquerade uses the egress device's own address; the same
+# test after the change shows request and reply on the member's device.
+track_ping() {
+	# shellcheck disable=SC2086
+	WRAP $PING -n -c $count -W $timeout -s $size -t $max_ttl -q $track_ip
+}
+
 clean_up() {
